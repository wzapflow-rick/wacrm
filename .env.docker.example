# ============================================================
# ZapFlow CRM — Docker env (VPS deploy)
# Copy to .env.docker and fill in. Used by docker-compose.crm.yml.
# ============================================================

# ---- Database ----
# Internal Docker hostname of your Postgres container + the CRM database.
# NO sslmode here — postgres:16 has no TLS and we're on the private network.
# Pick/create a dedicated database for the CRM (e.g. "crm_zapflow").
DATABASE_URL=postgres://postgres:SUA_SENHA_DO_POSTGRES@postgres_main:5432/crm_zapflow
# Optional: only relevant if you point DATABASE_URL at an SSL host with a
# self-signed cert. Leave unset for the plaintext private-network setup above.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ---- Better Auth ----
# Generate the secret on the VPS with:  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_long_random_secret
# The public URL where you'll access the CRM (through your reverse proxy).
# Use http://SERVER_IP:8090 for a quick test, or your real domain later.
BETTER_AUTH_URL=https://crm.seudominio.com

# ---- MinIO (storage) ----
MINIO_ROOT_USER=crmadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_password
# Public URL the browser uses to fetch stored files (avatars, media). This
# must be reachable FROM THE BROWSER — the internal http://crm_minio:9000 is
# not. Production: expose MinIO's port 9000 via your reverse proxy on a
# subdomain (below). Quick test with no domain: use the server IP + port 9000,
# e.g. MINIO_PUBLIC_URL=http://SEU_IP_DO_SERVIDOR:9000
MINIO_PUBLIC_URL=https://storage.seudominio.com

# ---- WhatsApp / Meta (optional, fill when connecting WhatsApp) ----
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
